{
  "name": "plynth",
  "private": true,
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "guard": "./scripts/public-guard.sh",
    "test": "bun test",
    "test:contracts": "cd contracts && forge test",
    "test:all": "forge test --root contracts && bun test",
    "verify:chain": "bun packages/chain/src/verify.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "typescript": "^7.0.2"
  }
}
