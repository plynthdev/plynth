{
  "name": "@plynth/sdk",
  "version": "0.0.0",
  "description": "Privacy kit for Robinhood Chain: stealth delivery, crowd-buy engine, shielded vault, viewing-key statements and relayer client.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js", "default": "./dist/index.js" },
    "./stealth": { "types": "./dist/stealth/index.d.ts", "import": "./dist/stealth/index.js", "default": "./dist/stealth/index.js" },
    "./crowd": { "types": "./dist/crowd/index.d.ts", "import": "./dist/crowd/index.js", "default": "./dist/crowd/index.js" },
    "./vault": { "types": "./dist/vault/index.d.ts", "import": "./dist/vault/index.js", "default": "./dist/vault/index.js" },
    "./statements": { "types": "./dist/statements/index.d.ts", "import": "./dist/statements/index.js", "default": "./dist/statements/index.js" },
    "./relayer": { "types": "./dist/relayer/index.d.ts", "import": "./dist/relayer/index.js", "default": "./dist/relayer/index.js" },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "bun scripts/build.ts",
    "test": "bun test"
  },
  "dependencies": {
    "@aztec/bb.js": "5.2.0",
    "@noble/ciphers": "1.3.0",
    "@noble/curves": "1.9.1",
    "@noble/hashes": "1.8.0",
    "@noir-lang/noir_js": "1.0.0-beta.25",
    "viem": "2.57.2"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "typescript": "7.0.2"
  }
}
