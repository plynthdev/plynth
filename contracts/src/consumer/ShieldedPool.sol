pragma solidity 0.8.28;

import {IERC20} from "@openzeppelin/contracts/token/ERC20/IERC20.sol";
import {SafeERC20} from "@openzeppelin/contracts/token/ERC20/utils/SafeERC20.sol";
import {Ownable, Ownable2Step} from "@openzeppelin/contracts/access/Ownable2Step.sol";
import {ReentrancyGuard} from "@openzeppelin/contracts/utils/ReentrancyGuard.sol";

import {Poseidon2} from "./verifiers/Poseidon2.sol";
import {HiddenConstants} from "./verifiers/HiddenConstants.sol";

/// UltraHonk verifier generated by bb (TransferVerifier / WithdrawVerifier).
interface IHonkVerifier {
    function verify(bytes calldata proof, bytes32[] calldata publicInputs) external view returns (bool);
}

/// Hidden Vault: USDG and Stock Tokens held as shielded notes.
///
/// A note is the Poseidon2 commitment of (asset, raw, ownerPk, blinding) (circuits/hidden). Deposits are
/// computed on-chain from those four values and wait in a pending queue for at least MIN_PENDING_DELAY; anyone
/// may then batch them into the depth-20 commitment tree (`insertPending`). A batch holds at least
/// MIN_INSERT_BATCH deposits, unless its oldest deposit has waited SOLO_INSERT_DELAY longer, so nobody can mint
/// a root per deposit and a lone deposit still gets in without a keeper.
///
/// Tree capacity never gates an exit. A spend's zero-value new note (full withdraw, zero change, zero transfer
/// output) has commitment 0 and inserts no leaf. When a tree's 2^20 leaves are used, the next leaf starts a new
/// tree (`LeafInserted.leafIndex` is global: tree = index / MAX_LEAVES, position = index % MAX_LEAVES) and the
/// full tree's final root stays a known root forever (`archivedRoot`), so its notes stay spendable. Transfers need
/// a real input (circuit), and direct deposits can carry a per-asset minimum (`minDeposit`), so filling trees
/// costs real notes. Until a pending deposit is inserted
/// its origin can take it back (`refundPending`). Spending a note needs a Noir proof: `transfer` (2 in, 2 out,
/// same asset) or `withdraw` (1 in, public amount out to a recipient, change note back in). A proof may use
/// any root this pool ever published (and every full tree's final root): the tree is append-only, so an old
/// root only proves membership of notes that really exist, and every nullifier can be used once. No number of
/// newer roots can expire a proof in flight (external audit M-5).
///
/// Units: notes hold raw token base units. Stock Token `uiMultiplier` changes never touch a note.
///
/// Exits are never gated: `transfer`, `withdraw`, `insertPending` and `refundPending` check nothing the
/// owner, a pause or a keeper controls. The owner can only pause new deposits, set CrowdBuy once, and change
/// per-asset deposit caps. A cap is the maximum shielded balance of an asset and applies to deposits only.
/// Caps start at 0 (no deposits); lowering applies at once, raising only after CAP_DELAY (48h on mainnet). This vault
/// needs a human audit before any cap is raised on mainnet; deploy scripts leave mainnet caps at 0.
///
/// Private sell/buy/park (todo 25) live in one ShieldedTrade module that the owner can set exactly once, and
/// only before the first deposit (so before any user has funds here). The module may spend nullifiers against
/// known roots, move a pool asset out (to swap it) and back in, and insert leaves; it carries its own swap and
/// settle verifiers. Treat its code as part of this contract for audit purposes.
///
/// Encrypted notes (ECIES to the owner's viewing key, see sdk vault) are opaque bytes here, at
/// most MAX_NOTE_BYTES each, emitted in `NoteEncrypted` keyed by commitment. A spend's ciphertexts are bound to
/// its proof (public input ext_hash = keccak256 of them mod p, see extHashOf): the ciphertext is the only copy
/// of a new note's blinding, so a relayer that could swap it could make the note unspendable. A withdraw that
/// pays a relayer fee also binds the relayer: its ext_hash is extHashOf(abi.encode(encryptedChange, relayer))
/// and only that msg.sender can submit it, so a copier who lands the same calldata first cannot take the fee
/// (external audit L-9). With relayerFee == 0 it stays extHashOf(encryptedChange) and anyone may submit.
contract ShieldedPool is Ownable2Step, ReentrancyGuard {
    using SafeERC20 for IERC20;

    struct PublicTransfer {
        bytes32 root;
        bytes32[2] nullifiers;
        bytes32[2] outCommitments;
        address asset;
    }

    struct PublicWithdraw {
        bytes32 root;
        bytes32 nullifier;
        bytes32 changeCommitment;
        address asset;
        uint256 amount; // leaves the pool: amount - relayerFee to recipient, relayerFee to msg.sender
        address recipient;
        uint256 relayerFee;
        bytes encryptedChange; // the change note for its owner (opaque, <= MAX_NOTE_BYTES)
    }

    enum PendingState {
        None,
        Queued,
        Inserted,
        Refunded
    }

    struct Pending {
        bytes32 commitment;
        address asset;
        uint64 createdAt;
        PendingState state;
        address origin;
        uint128 raw;
    }

    struct CapProposal {
        uint256 cap;
        uint64 eta;
    }

    uint256 public constant TREE_DEPTH = 20; // == HiddenConstants.TREE_DEPTH (asserted in tests)
    uint256 public constant MAX_LEAVES = 1 << TREE_DEPTH;
    uint64 public constant MIN_PENDING_DELAY = 1 hours;
    /// Smallest insertPending batch (queued deposits inserted, refunded entries not counted)...
    uint256 public constant MIN_INSERT_BATCH = 4;
    /// ...unless the oldest deposit it inserts is MIN_PENDING_DELAY + SOLO_INSERT_DELAY old (liveness).
    uint64 public constant SOLO_INSERT_DELAY = 1 hours;
    /// Hard floor for the deploy-time CAP_DELAY (mainnet/fork 48 hours, testnet 15 minutes).
    uint64 public constant MIN_CAP_DELAY = 10 minutes;
    uint64 public immutable CAP_DELAY;
    uint256 public constant MAX_NOTE_BYTES = 512;
    uint256 public constant MAX_RAW = type(uint128).max; // circuits range-check amounts to 128 bits
    uint256 private constant P = Poseidon2.P;

    IHonkVerifier public immutable transferVerifier;
    IHonkVerifier public immutable withdrawVerifier;

    address public crowd;
    address public trade; // ShieldedTrade module (set once, before any deposit)
    bool public depositsPaused;

    // Commitment tree (incremental Merkle tree, Poseidon2 nodes, HiddenConstants zero subtrees).
    uint256[TREE_DEPTH] private _filled;
    uint256 public nextLeaf;
    bytes32 public currentRoot;
    uint256 public rootCount; // roots ever published, the empty root is #1
    mapping(bytes32 root => uint256 seq) public rootSeq;

    mapping(bytes32 nullifier => bool) public nullifierSpent;
    /// Final roots of full trees: known forever, so their notes can always be spent.
    mapping(bytes32 root => bool) public archivedRoot;
    /// Smallest direct `deposit` per asset (0 = none). CrowdBuy deliveries (`depositFor`) are exempt.
    mapping(address asset => uint256) public minDeposit;

    Pending[] private _pending;
    uint256 public nextPending; // FIFO cursor for insertPending

    mapping(address asset => uint256) public cap;
    mapping(address asset => CapProposal) public capProposal;
    /// Raw units of `asset` in the pool's notes and pending deposits (deposits - refunds - withdrawals).
    mapping(address asset => uint256) public shielded;

    event CrowdSet(address indexed crowd);
    event TradeSet(address indexed trade);
    event DepositsPaused(bool paused);
    event CapProposed(address indexed asset, uint256 cap, uint64 eta);
    event CapApplied(address indexed asset, uint256 cap);
    event DepositQueued(
        uint256 indexed pendingId, address indexed asset, address indexed origin, uint256 raw, bytes32 commitment
    );
    event PendingRefunded(uint256 indexed pendingId, address indexed origin, uint256 raw);
    event PendingInserted(uint256 indexed pendingId, uint256 indexed leafIndex);
    event LeafInserted(uint256 indexed leafIndex, bytes32 commitment);
    event RootUpdated(bytes32 root, uint256 nextLeaf);
    event NoteEncrypted(bytes32 indexed commitment, bytes encryptedNote);
    event NullifierSpent(bytes32 indexed nullifier);
    event TreeArchived(uint256 indexed treeId, bytes32 finalRoot);
    event MinDepositSet(address indexed asset, uint256 minRaw);
    event Withdrawn(
        address indexed asset, address indexed recipient, uint256 amount, uint256 relayerFee, address relayer
    );

    error ZeroAddress();
    error AlreadySet();
    error NotCrowd();
    error NotTrade();
    error TooLate();
    error Paused();
    error BadAmount();
    error NoteTooLarge();
    error CapExceeded(uint256 shielded, uint256 raw, uint256 cap);
    error NotAFieldElement();
    error TransferAmountMismatch(uint256 received, uint256 expected);
    error NotPending(uint256 pendingId);
    error NotOrigin(uint256 pendingId);
    error NothingToInsert();
    error BatchTooSmall(uint256 inserted, uint256 minBatch);
    error UnknownRoot(bytes32 root);
    error NullifierAlreadySpent(bytes32 nullifier);
    error InvalidProof();
    error NoProposal();
    error TooEarly(uint64 eta);
    error DelayTooShort();

    modifier onlyCrowd() {
        if (msg.sender != crowd || msg.sender == address(0)) revert NotCrowd();
        _;
    }

    modifier onlyTrade() {
        if (msg.sender != trade || msg.sender == address(0)) revert NotTrade();
        _;
    }

    modifier depositsOpen() {
        if (depositsPaused) revert Paused();
        _;
    }

    constructor(IHonkVerifier transferVerifier_, IHonkVerifier withdrawVerifier_, address owner_, uint64 capDelay_)
        Ownable(owner_)
    {
        if (capDelay_ < MIN_CAP_DELAY) revert DelayTooShort();
        CAP_DELAY = capDelay_;
        if (address(transferVerifier_) == address(0) || address(withdrawVerifier_) == address(0)) {
            revert ZeroAddress();
        }
        transferVerifier = transferVerifier_;
        withdrawVerifier = withdrawVerifier_;
        _publishRoot(bytes32(HiddenConstants.EMPTY_ROOT));
    }

    // ---------------------------------------------------------------- owner

    /// Set once: CrowdBuy may deposit on behalf of Hidden-mode users (Hidden delivery).
    function setCrowd(address crowd_) external onlyOwner {
        if (crowd != address(0)) revert AlreadySet();
        if (crowd_ == address(0)) revert ZeroAddress();
        crowd = crowd_;
        emit CrowdSet(crowd_);
    }

    /// Set once, and only while the pool has never taken a deposit: the ShieldedTrade module.
    function setTrade(address trade_) external onlyOwner {
        if (trade != address(0)) revert AlreadySet();
        if (trade_ == address(0)) revert ZeroAddress();
        if (nextLeaf != 0 || _pending.length != 0) revert TooLate();
        trade = trade_;
        emit TradeSet(trade_);
    }

    /// Pauses or resumes new deposits only. Nothing else in this contract can be paused.
    function setDepositsPaused(bool paused) external onlyOwner {
        depositsPaused = paused;
        emit DepositsPaused(paused);
    }

    /// Smallest direct deposit of `asset` (raw units), against filling the tree with dust notes. Deposits only.
    function setMinDeposit(address asset, uint256 minRaw) external onlyOwner {
        if (asset == address(0)) revert ZeroAddress();
        minDeposit[asset] = minRaw;
        emit MinDepositSet(asset, minRaw);
    }

    /// Lowering (or keeping) a cap applies now; raising it applies after CAP_DELAY via `applyCap`.
    function proposeCap(address asset, uint256 newCap) external onlyOwner {
        if (asset == address(0)) revert ZeroAddress();
        if (newCap <= cap[asset]) {
            cap[asset] = newCap;
            delete capProposal[asset];
            emit CapApplied(asset, newCap);
            return;
        }
        uint64 eta = uint64(block.timestamp) + CAP_DELAY;
        capProposal[asset] = CapProposal(newCap, eta);
        emit CapProposed(asset, newCap, eta);
    }

    /// Anyone, once the proposal's 48h delay has passed.
    function applyCap(address asset) external {
        CapProposal memory p = capProposal[asset];
        if (p.eta == 0) revert NoProposal();
        if (block.timestamp < p.eta) revert TooEarly(p.eta);
        cap[asset] = p.cap;
        delete capProposal[asset];
        emit CapApplied(asset, p.cap);
    }

    // ---------------------------------------------------------------- deposits

    /// Queues a note for (asset, raw, ownerPk, blinding) funded by msg.sender, who is its origin.
    function deposit(address asset, uint256 raw, bytes32 ownerPk, bytes32 blinding, bytes calldata encryptedNote)
        external
        nonReentrant
        depositsOpen
        returns (uint256 pendingId)
    {
        if (raw < minDeposit[asset]) revert BadAmount();
        return _deposit(asset, raw, ownerPk, blinding, encryptedNote, msg.sender);
    }

    /// Hidden delivery: CrowdBuy pays, `origin` (the user) may refund while pending.
    function depositFor(
        address asset,
        uint256 raw,
        bytes32 ownerPk,
        bytes32 blinding,
        bytes calldata encryptedNote,
        address origin
    ) external nonReentrant onlyCrowd depositsOpen returns (uint256 pendingId) {
        if (origin == address(0)) revert ZeroAddress();
        return _deposit(asset, raw, ownerPk, blinding, encryptedNote, origin);
    }

    /// A pending deposit can return to its origin until it is inserted into the tree.
    function refundPending(uint256 pendingId) external nonReentrant {
        if (pendingId >= _pending.length) revert NotPending(pendingId);
        Pending storage p = _pending[pendingId];
        if (p.state != PendingState.Queued) revert NotPending(pendingId);
        if (msg.sender != p.origin) revert NotOrigin(pendingId);
        p.state = PendingState.Refunded;
        uint256 raw = p.raw;
        shielded[p.asset] -= raw;
        emit PendingRefunded(pendingId, p.origin, raw);
        IERC20(p.asset).safeTransfer(p.origin, raw);
    }

    /// Anyone: inserts up to `maxCount` queued deposits (FIFO) that are at least MIN_PENDING_DELAY old.
    /// Refunded entries are stepped over and count toward `maxCount`, so the loop is always bounded.
    /// Reverts BatchTooSmall if it would insert 1..MIN_INSERT_BATCH-1 deposits while the oldest of them is
    /// younger than MIN_PENDING_DELAY + SOLO_INSERT_DELAY (a call that only steps over refunds is allowed).
    function insertPending(uint256 maxCount) external nonReentrant returns (uint256 inserted) {
        uint256 i = nextPending;
        uint256 start = i;
        uint256 end = _pending.length;
        bytes32 root;
        uint256 oldest;
        while (i < end && maxCount != 0) {
            Pending storage p = _pending[i];
            if (p.state == PendingState.Queued) {
                if (block.timestamp < uint256(p.createdAt) + MIN_PENDING_DELAY) break;
                if (inserted == 0) oldest = p.createdAt;
                p.state = PendingState.Inserted;
                uint256 leafIndex;
                (leafIndex, root) = _insert(p.commitment);
                emit PendingInserted(i, leafIndex);
                ++inserted;
            }
            ++i;
            --maxCount;
        }
        if (i == start) revert NothingToInsert();
        if (!_batchOk(inserted, oldest)) revert BatchTooSmall(inserted, MIN_INSERT_BATCH);
        nextPending = i;
        if (inserted != 0) _publishRoot(root);
    }

    // ---------------------------------------------------------------- spends (never gated)

    /// 2-in/2-out private transfer within one asset. Public inputs: root, nullifiers[2], outCommitments[2], asset,
    /// extHashOf(abi.encode(encryptedNotes[0], encryptedNotes[1])).
    function transfer(bytes calldata proof, PublicTransfer calldata pub, bytes[2] calldata encryptedNotes)
        external
        nonReentrant
    {
        if (encryptedNotes[0].length > MAX_NOTE_BYTES || encryptedNotes[1].length > MAX_NOTE_BYTES) {
            revert NoteTooLarge();
        }
        if (pub.asset == address(0)) revert ZeroAddress();
        _field(pub.outCommitments[0]);
        _field(pub.outCommitments[1]);
        _knownRoot(pub.root);
        _spend(pub.nullifiers[0]);
        _spend(pub.nullifiers[1]);

        bytes32[] memory inputs = new bytes32[](7);
        inputs[0] = pub.root;
        inputs[1] = pub.nullifiers[0];
        inputs[2] = pub.nullifiers[1];
        inputs[3] = pub.outCommitments[0];
        inputs[4] = pub.outCommitments[1];
        inputs[5] = bytes32(uint256(uint160(pub.asset)));
        inputs[6] = extHashOf(abi.encode(encryptedNotes[0], encryptedNotes[1]));
        _verify(transferVerifier, proof, inputs);

        // A zero-value output has commitment 0 (circuit): no leaf. The circuit's conservation and real-input
        // rules make at least one output non-zero.
        bytes32 root;
        for (uint256 i; i < 2; ++i) {
            if (pub.outCommitments[i] == 0) continue;
            (, root) = _insert(pub.outCommitments[i]);
            emit NoteEncrypted(pub.outCommitments[i], encryptedNotes[i]);
        }
        if (root != 0) _publishRoot(root);
    }

    /// Spends one note: `amount` leaves the pool (amount - relayerFee to recipient, relayerFee to msg.sender)
    /// and the change note goes back into the tree. Public inputs: root, nullifier, changeCommitment, asset,
    /// amount, recipient, relayerFee, ext hash = extHashOf(encryptedChange) if relayerFee == 0, else
    /// extHashOf(abi.encode(encryptedChange, msg.sender)) (the proof names its relayer). Reverts only on a bad
    /// proof/root/nullifier or at the token itself (e.g. an issuer freeze of USDG), never on owner, pause or keeper state.
    function withdraw(bytes calldata proof, PublicWithdraw calldata pub) external nonReentrant {
        if (pub.encryptedChange.length > MAX_NOTE_BYTES) revert NoteTooLarge();
        if (pub.asset == address(0) || pub.recipient == address(0)) revert ZeroAddress();
        if (pub.amount > MAX_RAW || pub.relayerFee > pub.amount) revert BadAmount();
        _field(pub.changeCommitment);
        _knownRoot(pub.root);
        _spend(pub.nullifier);

        bytes32[] memory inputs = new bytes32[](8);
        inputs[0] = pub.root;
        inputs[1] = pub.nullifier;
        inputs[2] = pub.changeCommitment;
        inputs[3] = bytes32(uint256(uint160(pub.asset)));
        inputs[4] = bytes32(pub.amount);
        inputs[5] = bytes32(uint256(uint160(pub.recipient)));
        inputs[6] = bytes32(pub.relayerFee);
        inputs[7] = pub.relayerFee == 0
            ? extHashOf(pub.encryptedChange)
            : extHashOf(abi.encode(pub.encryptedChange, msg.sender)); // L-9: the fee goes to the bound relayer only
        _verify(withdrawVerifier, proof, inputs);

        if (pub.changeCommitment != 0) {
            // Zero change (commitment 0, circuit): no leaf, so a full exit never needs tree space.
            (, bytes32 root) = _insert(pub.changeCommitment);
            emit NoteEncrypted(pub.changeCommitment, pub.encryptedChange);
            _publishRoot(root);
        }

        shielded[pub.asset] -= pub.amount;
        emit Withdrawn(pub.asset, pub.recipient, pub.amount, pub.relayerFee, msg.sender);
        IERC20 token = IERC20(pub.asset);
        uint256 toRecipient = pub.amount - pub.relayerFee;
        if (toRecipient != 0) token.safeTransfer(pub.recipient, toRecipient);
        if (pub.relayerFee != 0) token.safeTransfer(msg.sender, pub.relayerFee);
    }

    // ---------------------------------------------------------------- ShieldedTrade hooks

    /// Spends `nullifier` against a known `root`. The module verifies the proof in the same transaction.
    function tradeSpend(bytes32 root, bytes32 nullifier) external nonReentrant onlyTrade {
        _knownRoot(root);
        _spend(nullifier);
    }

    /// Sends `amount` of `asset` (taken out of a spent note) to the module for a swap, park or unpark.
    function tradeTake(address asset, uint256 amount) external nonReentrant onlyTrade {
        shielded[asset] -= amount;
        IERC20(asset).safeTransfer(msg.sender, amount);
    }

    /// Pulls `amount` of `asset` (a swap output) from the module. `capped` applies the deposit cap (every
    /// swap output except an unpark, which is an exit back to USDG and never gated).
    function tradeCredit(address asset, uint256 amount, bool capped) external nonReentrant onlyTrade {
        uint256 held = shielded[asset];
        if (capped && held + amount > cap[asset]) revert CapExceeded(held, amount, cap[asset]);
        shielded[asset] = held + amount;
        IERC20 token = IERC20(asset);
        uint256 before = token.balanceOf(address(this));
        token.safeTransferFrom(msg.sender, address(this), amount);
        uint256 received = token.balanceOf(address(this)) - before;
        if (received != amount) revert TransferAmountMismatch(received, amount);
    }

    /// Inserts `leaves` (with their encrypted notes) and publishes one new root. A 0 leaf (a zero-value note) is
    /// skipped.
    function tradeInsert(bytes32[] calldata leaves, bytes[] calldata notes) external nonReentrant onlyTrade {
        uint256 n = leaves.length;
        if (n == 0 || notes.length != n) revert BadAmount();
        bytes32 root;
        for (uint256 i; i < n; ++i) {
            if (notes[i].length > MAX_NOTE_BYTES) revert NoteTooLarge();
            _field(leaves[i]);
            if (leaves[i] == 0) continue;
            (, root) = _insert(leaves[i]);
            emit NoteEncrypted(leaves[i], notes[i]);
        }
        if (root != 0) _publishRoot(root);
    }

    // ---------------------------------------------------------------- views

    /// True for every root this pool ever published and every full tree's final root (which a two-leaf insert
    /// can archive without publishing). Roots never expire (M-5): the tree is append-only and nullifiers stop reuse.
    function isKnownRoot(bytes32 root) public view returns (bool) {
        return rootSeq[root] != 0 || archivedRoot[root];
    }

    /// The tree a global leaf index is in, and its position there (the circuits' `index`).
    function treeOf(uint256 leafIndex) public pure returns (uint256 treeId, uint256 position) {
        return (leafIndex / MAX_LEAVES, leafIndex % MAX_LEAVES);
    }

    /// keccak256(data) mod p: the public input binding a spend's encrypted notes to its proof.
    function extHashOf(bytes memory data) public pure returns (bytes32) {
        return bytes32(uint256(keccak256(data)) % P);
    }

    /// The note commitment for (asset, raw, ownerPk, blinding), as deposits compute it.
    function commitmentOf(address asset, uint256 raw, bytes32 ownerPk, bytes32 blinding)
        public
        pure
        returns (bytes32)
    {
        return bytes32(Poseidon2.hash4(uint256(uint160(asset)), raw, uint256(ownerPk), uint256(blinding)));
    }

    function pending(uint256 pendingId) external view returns (Pending memory) {
        return _pending[pendingId];
    }

    function pendingCount() external view returns (uint256) {
        return _pending.length;
    }

    /// Queued deposits that `insertPending(limit)` would insert now (stops at the first one still inside its
    /// delay; counts at most `limit` queue entries). 0 when that call would revert BatchTooSmall.
    function readyCount(uint256 limit) external view returns (uint256 ready) {
        uint256 end = _pending.length;
        uint256 oldest;
        for (uint256 i = nextPending; i < end && limit != 0; ++i) {
            Pending storage p = _pending[i];
            if (p.state == PendingState.Queued) {
                if (block.timestamp < uint256(p.createdAt) + MIN_PENDING_DELAY) break;
                if (ready == 0) oldest = p.createdAt;
                ++ready;
            }
            --limit;
        }
        if (!_batchOk(ready, oldest)) return 0;
    }

    // ---------------------------------------------------------------- internal

    function _deposit(
        address asset,
        uint256 raw,
        bytes32 ownerPk,
        bytes32 blinding,
        bytes calldata encryptedNote,
        address origin
    ) private returns (uint256 pendingId) {
        if (asset == address(0)) revert ZeroAddress();
        if (raw == 0 || raw > MAX_RAW) revert BadAmount();
        if (encryptedNote.length > MAX_NOTE_BYTES) revert NoteTooLarge();
        uint256 held = shielded[asset];
        uint256 c = cap[asset];
        if (held + raw > c) revert CapExceeded(held, raw, c);
        _field(ownerPk);
        _field(blinding);
        bytes32 commitment = commitmentOf(asset, raw, ownerPk, blinding);

        shielded[asset] = held + raw;
        pendingId = _pending.length;
        _pending.push(
            Pending({
                commitment: commitment,
                asset: asset,
                createdAt: uint64(block.timestamp),
                state: PendingState.Queued,
                origin: origin,
                raw: uint128(raw)
            })
        );
        emit DepositQueued(pendingId, asset, origin, raw, commitment);
        emit NoteEncrypted(commitment, encryptedNote);

        IERC20 token = IERC20(asset);
        uint256 before = token.balanceOf(address(this));
        token.safeTransferFrom(msg.sender, address(this), raw);
        uint256 received = token.balanceOf(address(this)) - before;
        if (received != raw) revert TransferAmountMismatch(received, raw);
    }

    /// Appends at global index `nextLeaf`. Position 0 of a tree overwrites every `_filled` level, so a new tree
    /// never reads the previous tree's nodes; the last position archives the full tree's root.
    function _insert(bytes32 leaf) private returns (uint256 index, bytes32 root) {
        index = nextLeaf;
        uint256 node = uint256(leaf);
        uint256 pos = index % MAX_LEAVES;
        for (uint256 level; level < TREE_DEPTH; ++level) {
            if (pos & 1 == 0) {
                _filled[level] = node;
                node = Poseidon2.hash2(node, HiddenConstants.zeros(level));
            } else {
                node = Poseidon2.hash2(_filled[level], node);
            }
            pos >>= 1;
        }
        nextLeaf = index + 1;
        root = bytes32(node);
        emit LeafInserted(index, leaf);
        if (index % MAX_LEAVES == MAX_LEAVES - 1) {
            archivedRoot[root] = true;
            emit TreeArchived(index / MAX_LEAVES, root);
        }
    }

    function _publishRoot(bytes32 root) private {
        uint256 seq = rootCount + 1;
        rootCount = seq;
        rootSeq[root] = seq;
        currentRoot = root;
        emit RootUpdated(root, nextLeaf);
    }

    /// The insertPending batch rule: no leaf, a full batch, or the oldest inserted deposit past the solo delay.
    function _batchOk(uint256 inserted, uint256 oldestCreatedAt) private view returns (bool) {
        return inserted == 0 || inserted >= MIN_INSERT_BATCH
            || block.timestamp >= oldestCreatedAt + MIN_PENDING_DELAY + SOLO_INSERT_DELAY;
    }

    function _knownRoot(bytes32 root) private view {
        if (!isKnownRoot(root)) revert UnknownRoot(root);
    }

    /// Marks a nullifier spent. Nullifiers must be canonical field elements: the verifier reduces inputs
    /// mod p, so n and n + p would otherwise be two different keys for one note.
    function _spend(bytes32 nullifier) private {
        _field(nullifier);
        if (nullifierSpent[nullifier]) revert NullifierAlreadySpent(nullifier);
        nullifierSpent[nullifier] = true;
        emit NullifierSpent(nullifier);
    }

    function _field(bytes32 x) private pure {
        if (uint256(x) >= P) revert NotAFieldElement();
    }

    function _verify(IHonkVerifier v, bytes calldata proof, bytes32[] memory inputs) private view {
        bool ok;
        try v.verify(proof, inputs) returns (bool r) {
            ok = r;
        } catch {
            ok = false;
        }
        if (!ok) revert InvalidProof();
    }
}
