# Applies the Drizzle migrations (app/drizzle) to the database in /etc/plynth/db.env. deploy.sh starts it after
# switching /opt/plynth/current and before restarting plynth.target; it is not part of the target.
[Unit]
Description=Plynth database migrations
Documentation=file:/opt/plynth/current/app/scripts/server/README.md
After=network-online.target postgresql.service
Wants=postgresql.service

[Service]
Type=oneshot
User=plynth
Group=plynth
WorkingDirectory=/var/lib/plynth
Environment=HOME=/var/lib/plynth
EnvironmentFile=/etc/plynth/plynth.env
EnvironmentFile=/etc/plynth/db.env
ExecStart=/usr/local/bin/bun /opt/plynth/current/app/src/bin/migrate.ts
TimeoutStartSec=600
StandardOutput=journal
StandardError=journal
SyslogIdentifier=plynth-migrate
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/plynth
