# Plynth eligibility: wallet screening and attestations.
# Installed to /etc/systemd/system by provision.sh and deploy.sh; restarted and stopped with plynth.target.

[Unit]
Description=Plynth eligibility (wallet screening and attestations)
Documentation=file:/opt/plynth/current/app/scripts/server/README.md
PartOf=plynth.target
After=network-online.target postgresql.service
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
# Its own Unix user and only its own settings (audit: one user and one env file for every service).
User=plynth-eligibility
Group=plynth-eligibility
SupplementaryGroups=plynth plynth-screening
StateDirectory=plynth-eligibility
WorkingDirectory=/var/lib/plynth-eligibility
Environment=HOME=/var/lib/plynth-eligibility
EnvironmentFile=/etc/plynth/env/common.env
EnvironmentFile=/etc/plynth/db.env
EnvironmentFile=/etc/plynth/env/eligibility.env
EnvironmentFile=-/etc/plynth/eligibility.env
ReadWritePaths=/var/lib/plynth-eligibility /var/lib/plynth/data
ExecStart=/usr/local/bin/bun /opt/plynth/current/app/src/bin/eligibility.ts
Restart=always
RestartSec=5
TimeoutStopSec=30
MemoryMax=384M
StandardOutput=journal
StandardError=journal
SyslogIdentifier=plynth-eligibility
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=plynth.target
