# Plynth api: read API, tRPC and REST.
# Installed to /etc/systemd/system by provision.sh and deploy.sh; restarted and stopped with plynth.target.

[Unit]
Description=Plynth api (read API, tRPC and REST)
Documentation=file:/opt/plynth/current/app/scripts/server/README.md
PartOf=plynth.target
After=network-online.target postgresql.service
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
# Its own Unix user and only its own settings (audit: one user and one env file for every service).
User=plynth-api
Group=plynth-api
SupplementaryGroups=plynth plynth-screening
StateDirectory=plynth-api
WorkingDirectory=/var/lib/plynth-api
Environment=HOME=/var/lib/plynth-api
EnvironmentFile=/etc/plynth/env/common.env
EnvironmentFile=/etc/plynth/db.env
EnvironmentFile=/etc/plynth/env/api.env
EnvironmentFile=-/etc/plynth/api.env
ReadWritePaths=/var/lib/plynth-api /var/lib/plynth/data
ExecStart=/usr/local/bin/bun /opt/plynth/current/app/src/bin/api.ts
Restart=always
RestartSec=5
TimeoutStopSec=30
MemoryMax=512M
StandardOutput=journal
StandardError=journal
SyslogIdentifier=plynth-api
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=plynth.target
