# Downloads DB-IP's free IP to Country Lite database (app/scripts/download-dbip.ts) to ELIGIBILITY_IP_DB, then
# restarts the services that load it at startup (the eligibility service and the API, which mounts the same routes).
# Run by plynth-ipdb.timer each month and by deploy.sh when the file is missing.
[Unit]
Description=Plynth IP country database refresh
After=network-online.target
Wants=network-online.target
ConditionPathExists=/opt/plynth/current/app/scripts/download-dbip.ts

[Service]
Type=oneshot
# Its own Unix user and only its own settings (audit: one user and one env file for every service).
User=plynth-eligibility
Group=plynth-eligibility
SupplementaryGroups=plynth-screening
StateDirectory=plynth-eligibility
WorkingDirectory=/var/lib/plynth-eligibility
Environment=HOME=/var/lib/plynth-eligibility
EnvironmentFile=/etc/plynth/env/common.env
EnvironmentFile=/etc/plynth/env/eligibility.env
ReadWritePaths=/var/lib/plynth-eligibility /var/lib/plynth/data
InaccessiblePaths=-/etc/plynth/keys
ExecStart=/usr/local/bin/bun /opt/plynth/current/app/scripts/download-dbip.ts
ExecStartPost=+/usr/bin/systemctl try-restart plynth-eligibility.service plynth-api.service
TimeoutStartSec=300
StandardOutput=journal
StandardError=journal
SyslogIdentifier=plynth-ipdb
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
