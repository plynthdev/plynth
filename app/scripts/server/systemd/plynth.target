# Every Plynth service. `systemctl restart plynth.target` restarts each enabled plynth-*.service (they are PartOf it);
# `systemctl stop plynth.target` stops them. A service joins the target when it is enabled (WantedBy=plynth.target).
[Unit]
Description=Plynth backend services
Documentation=file:/opt/plynth/current/app/scripts/server/README.md
Wants=network-online.target postgresql.service
After=network-online.target postgresql.service

[Install]
WantedBy=multi-user.target
