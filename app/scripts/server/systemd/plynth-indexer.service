# Plynth indexer: the only process that polls the chain for logs.
# Installed to /etc/systemd/system by provision.sh and deploy.sh; restarted and stopped with plynth.target.

[Unit]
Description=Plynth indexer (the only process that polls the chain for logs)
Documentation=file:/opt/plynth/current/app/scripts/server/README.md
PartOf=plynth.target
After=network-online.target postgresql.service
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
# Its own Unix user and only its own settings (audit: one user and one env file for every service).
User=plynth-indexer
Group=plynth-indexer
StateDirectory=plynth-indexer
WorkingDirectory=/var/lib/plynth-indexer
Environment=HOME=/var/lib/plynth-indexer
EnvironmentFile=/etc/plynth/env/common.env
EnvironmentFile=/etc/plynth/db.env
EnvironmentFile=/etc/plynth/env/indexer.env
EnvironmentFile=-/etc/plynth/indexer.env
ReadWritePaths=/var/lib/plynth-indexer
InaccessiblePaths=-/etc/plynth/keys
ExecStart=/usr/local/bin/bun /opt/plynth/current/app/src/bin/indexer.ts
Restart=always
RestartSec=5
TimeoutStopSec=30
MemoryMax=512M
StandardOutput=journal
StandardError=journal
SyslogIdentifier=plynth-indexer
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=plynth.target
