# Plynth treasury-webhooks: signed board webhooks.
# Installed to /etc/systemd/system by provision.sh and deploy.sh; restarted and stopped with plynth.target.

[Unit]
Description=Plynth treasury-webhooks (signed board webhooks)
Documentation=file:/opt/plynth/current/app/scripts/server/README.md
PartOf=plynth.target
After=network-online.target postgresql.service
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
# Its own Unix user and only its own settings (audit: one user and one env file for every service).
User=plynth-treasury
Group=plynth-treasury
SupplementaryGroups=plynth
StateDirectory=plynth-treasury
WorkingDirectory=/var/lib/plynth-treasury
Environment=HOME=/var/lib/plynth-treasury
EnvironmentFile=/etc/plynth/env/common.env
EnvironmentFile=/etc/plynth/db.env
EnvironmentFile=/etc/plynth/env/treasury.env
EnvironmentFile=-/etc/plynth/treasury-webhooks.env
ReadWritePaths=/var/lib/plynth-treasury
ExecStart=/usr/local/bin/bun /opt/plynth/current/app/src/bin/treasury-webhooks.ts run
Restart=always
RestartSec=10
TimeoutStopSec=30
MemoryMax=256M
StandardOutput=journal
StandardError=journal
SyslogIdentifier=plynth-treasury-webhooks
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=plynth.target
