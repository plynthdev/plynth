# Plynth relayer: gasless Quiet claims and Hidden Vault withdraws.
# Installed to /etc/systemd/system by provision.sh and deploy.sh; restarted and stopped with plynth.target.

[Unit]
Description=Plynth relayer (gasless Quiet claims and Hidden Vault withdraws)
Documentation=file:/opt/plynth/current/app/scripts/server/README.md
PartOf=plynth.target
After=network-online.target postgresql.service
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
# Its own Unix user and only its own settings (audit: one user and one env file for every service).
User=plynth-relayer
Group=plynth-relayer
SupplementaryGroups=plynth
StateDirectory=plynth-relayer
WorkingDirectory=/var/lib/plynth-relayer
Environment=HOME=/var/lib/plynth-relayer
EnvironmentFile=/etc/plynth/env/common.env
EnvironmentFile=/etc/plynth/env/relayer.env
EnvironmentFile=-/etc/plynth/relayer.env
ReadWritePaths=/var/lib/plynth-relayer
ExecStart=/usr/local/bin/bun /opt/plynth/current/app/src/bin/relayer.ts
Restart=always
RestartSec=5
TimeoutStopSec=30
MemoryMax=384M
StandardOutput=journal
StandardError=journal
SyslogIdentifier=plynth-relayer
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=plynth.target
