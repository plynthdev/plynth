# Plynth mcp: read-only treasury tools over MCP.
# Installed to /etc/systemd/system by provision.sh and deploy.sh; restarted and stopped with plynth.target.

[Unit]
Description=Plynth mcp (read-only treasury tools over MCP)
Documentation=file:/opt/plynth/current/app/scripts/server/README.md
PartOf=plynth.target
After=network-online.target postgresql.service
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
# Its own Unix user and only its own settings (audit: one user and one env file for every service).
User=plynth-mcp
Group=plynth-mcp
StateDirectory=plynth-mcp
WorkingDirectory=/var/lib/plynth-mcp
Environment=HOME=/var/lib/plynth-mcp
EnvironmentFile=/etc/plynth/env/common.env
EnvironmentFile=/etc/plynth/db.env
EnvironmentFile=/etc/plynth/env/mcp.env
EnvironmentFile=-/etc/plynth/mcp.env
ReadWritePaths=/var/lib/plynth-mcp
InaccessiblePaths=-/etc/plynth/keys
ExecStart=/usr/local/bin/bun /opt/plynth/current/app/src/bin/mcp.ts
Restart=always
RestartSec=5
TimeoutStopSec=30
MemoryMax=256M
StandardOutput=journal
StandardError=journal
SyslogIdentifier=plynth-mcp
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=plynth.target
