# The settings of the Plynth services on Robinhood Chain MAINNET (chain id 4663), in one template.
#
# provision.sh fills each GENERATED_BY_PROVISION with a fresh random secret and splits this file by variable into
# one file per service, /etc/plynth/env/{common,indexer,keeper,api,eligibility,relayer,mcp,treasury}.env (root, 0600;
# split-env.sh says which variable goes where). Each service runs as its own Unix user and systemd hands it only
# common.env, its own file and, where it needs one, /etc/plynth/db.env (DATABASE_URL, written by provision.sh): the
# relayer never sees the keeper's secret, the indexer never sees a keystore path. A server provisioned before the
# split keeps its old /etc/plynth/plynth.env as plynth.env.pre-split after the first deploy splits it.
# Replace every CHANGE_ME (in /etc/plynth/env/*.env) by hand before the first deploy: deploy.sh refuses to start
# anything while one is left. An optional /etc/plynth/<unit>.env (e.g. keeper.env) still overrides values for one
# unit. Format: KEY=value, no quotes, no `export`. Blank = unset (the default in app/src/config.ts applies).
# Do not set DATABASE_URL here: it lives in db.env.
#
# KEYS. The service wallets are Foundry keystores. The owner copies them, with one password file each, to
# /etc/plynth/keys/ on the server by hand (scp from the machine that holds them). They are never committed to any
# repository, never written into this file as raw *_KEY values, and never sent by deploy.sh:
#   /etc/plynth/keys/plynth-main-keeper       /etc/plynth/keys/keeper.password
#   /etc/plynth/keys/plynth-main-relayer      /etc/plynth/keys/relayer.password
#   /etc/plynth/keys/plynth-main-controller   /etc/plynth/keys/controller.password
#   /etc/plynth/keys/plynth-main-attester     /etc/plynth/keys/attester.password
# then run deploy.sh (or provision.sh --units-only): it gives each file to the one service that signs with it
# (root:plynth-keeper, root:plynth-relayer, root:plynth-screening for the attester, root:plynth-treasury; 0440).
#
# DEPLOYMENT FILE. The mainnet deploy (MainnetBeta.s.sol) writes app/deployments/4663-beta.json. On the owner's
# machine, `bun scripts/mainnet/setup.ts --check-only` turns it into 4663.json + 4663-treasury.json, the files the
# services read (with the L2 deploy block). deploy.sh ships all three to /opt/plynth/current/app/deployments/.
# ELIGIBILITY_REGISTRY and TREASURY_FACTORY below are the eligibilityRegistry and treasuryFactory addresses in
# 4663.json; deploy.sh checks that they match.

# ---------------------------------------------------------------- shared
# Free public RPC (rate-limited). A free Alchemy URL works too: https://robinhood-mainnet.g.alchemy.com/v2/<KEY>
RHC_MAINNET_RPC_URL=https://rpc.mainnet.chain.robinhood.com
# debug | info | warn | error | silent
LOG_LEVEL=info

# ---------------------------------------------------------------- indexer (plynth-indexer)
INDEXER_CHAIN=mainnet
INDEXER_PORT=8787
INDEXER_POLL_MS=4000
# Logs are read this many blocks below the head (mainnet: at least 2).
INDEXER_CONFIRMATIONS=2
INDEXER_DEPLOYMENTS_DIR=/opt/plynth/current/app/deployments
# Blank = the deployBlock in 4663.json.
INDEXER_FROM_BLOCK=
INDEXER_WALLETS=
INDEXER_STREAMS_FILE=

# ---------------------------------------------------------------- keeper (plynth-keeper, one instance only)
KEEPER_CHAIN=mainnet
KEEPER_PORT=8788
KEEPER_INTERVAL_MS=20000
KEEPER_DEPLOYMENTS_DIR=/opt/plynth/current/app/deployments
# Seals beacon secrets and bank-link tokens in the database; the API reads it too. Moving a running keeper here from
# another machine: copy that machine's value AND its database, and stop the old keeper first.
KEEPER_SECRET_KEY=GENERATED_BY_PROVISION
KEEPER_KEYSTORE=/etc/plynth/keys/plynth-main-keeper
KEEPER_KEYSTORE_PASSWORD_FILE=/etc/plynth/keys/keeper.password
KEEPER_LOOKAHEAD=2
# Quiet delivery proofs are read this many blocks below the head (mainnet: at least 2).
KEEPER_CONFIRMATIONS=2
# Blank = every job (refresh-mock-feeds does nothing on mainnet: the feeds are the real Chainlink feeds).
KEEPER_JOBS=
SPLIT_PARTS=2
# Accrue transactions the keeper sends per job per pass, and per user in any 7 days (statement imports are
# user-supplied, so these bound what they can cost in gas). Blank = 200 and 100.
KEEPER_MAX_ACCRUALS_PER_PASS=
KEEPER_MAX_ACCRUALS_PER_USER_WEEK=
# perp-poke: a perp market with open positions whose stored price is older than this (seconds) is poked, so a
# delisting's grace starts from a recent price. Blank = 3600.
KEEPER_PERP_POKE_AGE_S=

# ---------------------------------------------------------------- relayer (plynth-relayer, behind Caddy)
RELAYER_CHAIN=mainnet
RELAYER_PORT=8791
RELAYER_DEPLOYMENTS_DIR=/opt/plynth/current/app/deployments
RELAYER_KEYSTORE=/etc/plynth/keys/plynth-main-relayer
RELAYER_KEYSTORE_PASSWORD_FILE=/etc/plynth/keys/relayer.password
# 1: rate-limit by X-Forwarded-For, which Caddy sets to the real client address (the Caddyfile drops any value a
# client sends). Without it every request comes from 127.0.0.1 and shares one limit.
RELAYER_TRUST_PROXY=1
RELAYER_IP_LIMIT=100
RELAYER_STEALTH_LIMIT=20
# Minimum Hidden Vault withdraw fee per asset, "0xasset:raw,..." in raw token units. REQUIRED on mainnet (the relayer
# refuses to start without it); an asset not listed is not relayed. Default: 0.25 USDG (6 decimals) and 0.001 of each
# Stock Token (18 decimals) from app/deployments/4663.json. Raise them if gas costs more than that.
RELAYER_WITHDRAW_MIN_FEES=0x5fc5360D0400a0Fd4f2af552ADD042D716F1d168:250000,0xaF3D76f1834A1d425780943C99Ea8A608f8a93f9:1000000000000000,0x12f190a9F9d7D37a250758b26824B97CE941bF54:1000000000000000,0x2e0847E8910a9732eB3fb1bb4b70a580ADAD4FE3:1000000000000000,0xc0D6457C16Cc70d6790Dd43521C899C87ce02f35:1000000000000000,0xe93237C50D904957Cf27E7B1133b510C669c2e74:1000000000000000,0xec262a75e413fAfD0dF80480274532C79D42da09:1000000000000000,0xd0601CE157Db5bdC3162BbaC2a2C8aF5320D9EEC:1000000000000000,0x117cc2133c37B721F49dE2A7a74833232B3B4C0C:1000000000000000,0x322F0929c4625eD5bAd873c95208D54E1c003b2d:1000000000000000
# Smallest Quiet claim the relayer pays gas for, per token (StealthClaims takes no fee). REQUIRED on mainnet; smaller
# claims are refused (the user claims them from their own wallet). Default: 1 USDG and 0.001 of each Stock Token.
RELAYER_CLAIM_MIN_RAW=0x5fc5360D0400a0Fd4f2af552ADD042D716F1d168:1000000,0xaF3D76f1834A1d425780943C99Ea8A608f8a93f9:1000000000000000,0x12f190a9F9d7D37a250758b26824B97CE941bF54:1000000000000000,0x2e0847E8910a9732eB3fb1bb4b70a580ADAD4FE3:1000000000000000,0xc0D6457C16Cc70d6790Dd43521C899C87ce02f35:1000000000000000,0xe93237C50D904957Cf27E7B1133b510C669c2e74:1000000000000000,0xec262a75e413fAfD0dF80480274532C79D42da09:1000000000000000,0xd0601CE157Db5bdC3162BbaC2a2C8aF5320D9EEC:1000000000000000,0x117cc2133c37B721F49dE2A7a74833232B3B4C0C:1000000000000000,0x322F0929c4625eD5bAd873c95208D54E1c003b2d:1000000000000000

# ---------------------------------------------------------------- api (plynth-api, behind Caddy)
API_CHAIN=mainnet
API_PORT=8789
# 1: rate limits use the X-Forwarded-For Caddy sets (the real client address). Without it every request is 127.0.0.1.
API_TRUST_PROXY=1
# Requests per minute per client address (IPv6: per /64), and for proof/statement verification and the CFO pack.
# Blank = 600 and 30.
API_RATE_LIMIT=
API_HEAVY_RATE_LIMIT=
API_DEPLOYMENTS_DIR=/opt/plynth/current/app/deployments
# Comma-separated exact origins allowed to call the API from a browser. Add every frontend origin you serve.
CORS_ORIGINS=https://plynthnetwork.com
# 1 mounts /v1/roundups/* (statement import and bank link); the bank link also needs the PLAID_* values.
ROUNDUPS_ENABLED=1
# New statement rows one user may import in any 7 days. Blank = 2000.
ROUNDUPS_MAX_ROWS_PER_WEEK=
# Statement imports per hour per client address (IPv6: per /64) and per wallet. Blank = 30 and 10.
ROUNDUPS_IMPORT_IP_LIMIT=
ROUNDUPS_IMPORT_USER_LIMIT=
PLAID_ENV=sandbox
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_COUNTRY_CODES=

# ---------------------------------------------------------------- eligibility (plynth-eligibility; the API mounts the same routes)
ELIGIBILITY_CHAIN=mainnet
ELIGIBILITY_PORT=8790
# eligibilityRegistry from app/deployments/4663.json. Set = screening on (needs the attester keystore below).
ELIGIBILITY_REGISTRY=CHANGE_ME
ELIGIBILITY_KEYSTORE=/etc/plynth/keys/plynth-main-attester
ELIGIBILITY_KEYSTORE_PASSWORD_FILE=/etc/plynth/keys/attester.password
# Written by plynth-ipdb.service (monthly) and the sanctions list refresh; /var/lib/plynth is the services' state dir.
ELIGIBILITY_IP_DB=/var/lib/plynth/data/dbip-country-lite.mmdb
ELIGIBILITY_SANCTIONS_CACHE=/var/lib/plynth/data/ofac-sdn-addresses.json
ELIGIBILITY_SANCTIONS_ORACLE=
# 1: take the client address from the proxy headers. Required behind Caddy (otherwise every IP is 127.0.0.1, which
# has no country, and every screen fails). The Caddyfile removes CF-Connecting-IP and CF-IPCountry sent by clients;
# if Cloudflare's proxy is put in front, see README.md before changing that.
ELIGIBILITY_TRUST_PROXY=1
# Never 1 on mainnet.
ELIGIBILITY_ALLOW_UNKNOWN_IP=0
ELIGIBILITY_IP_LIMIT=10
ELIGIBILITY_ADDRESS_LIMIT=5

# ---------------------------------------------------------------- mcp (plynth-mcp; the API issues the tokens)
MCP_PORT=8792
# HMAC key for per-treasury MCP tokens (>= 32 characters), shared by the API and the MCP server.
MCP_TOKEN_SECRET=GENERATED_BY_PROVISION
RPC_URL=https://rpc.mainnet.chain.robinhood.com
DEPLOYMENT_JSON=/opt/plynth/current/app/deployments/4663.json

# ---------------------------------------------------------------- treasury (shared by the treasury services)
TREASURY_RPC_URL=https://rpc.mainnet.chain.robinhood.com
TREASURY_CHAIN_ID=4663
TREASURY_POLL_MS=2000
# treasuryFactory from app/deployments/4663.json.
TREASURY_FACTORY=CHANGE_ME
# Treasuries to mark / post receipts for (blank = every treasury the factory created).
TREASURY_ACCOUNTS=
TREASURY_CONTROLLER_KEYSTORE=/etc/plynth/keys/plynth-main-controller
TREASURY_CONTROLLER_KEYSTORE_PASSWORD_FILE=/etc/plynth/keys/controller.password

# ---------------------------------------------------------------- treasury-marks, treasury-webhooks (started by deploy.sh)
TREASURY_MARKS_PORT=8797
TREASURY_MARK_INTERVAL_S=300
TREASURY_WEBHOOKS_PORT=8799
TREASURY_WEBHOOK_INTERVAL_S=15

# ---------------------------------------------------------------- per-treasury services (optional, enabled by hand)
# plynth-treasury-desks / -close / -risk / -receipts / -reconciler serve one treasury each. Fill these (here or in
# /etc/plynth/<service>.env), copy the desk keystores the same way as above, then `systemctl enable --now <unit>`.
TREASURY_DESKS_PORT=8793
TREASURY_CLOSE_PORT=8794
TREASURY_RISK_PORT=8795
TREASURY_RECEIPTS_PORT=8796
TREASURY_RECONCILER_PORT=8798
TREASURY_ACCOUNT=
TREASURY_CONFIG=
TREASURY_CASH_DESK_KEYSTORE=
TREASURY_CASH_DESK_KEYSTORE_PASSWORD_FILE=
TREASURY_EQUITY_DESK_KEYSTORE=
TREASURY_EQUITY_DESK_KEYSTORE_PASSWORD_FILE=
TREASURY_JURY=on
OLLAMA_HOST=
TREASURY_PERIOD_CLOSE=
TREASURY_CLOSE_SKIP_RECONCILE=0
TREASURY_POSITION_MIRROR=
RISK_STATIC_READERS=
RISK_WEBHOOK_URLS=
RISK_WEBHOOK_SECRET=
TREASURY_RECEIPTS=
TREASURY_RECONCILE_CONFIG=
ORDERLY_SECRET=
TREASURY_WEBHOOK_URLS=
TREASURY_WEBHOOK_SECRET=
