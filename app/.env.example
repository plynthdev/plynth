# Every variable the services read, once, grouped by service. All are checked at startup (src/config.ts);
# blank = unset (the default applies). Never commit a filled-in copy: .env files are gitignored.
# Prefer Foundry keystores (`cast wallet import <name> --interactive`) over raw *_KEY values.

# ---------------------------------------------------------------- shared
# Postgres. `bun run db:create && bun run migrate` sets it up.
DATABASE_URL=postgres://localhost:5432/plynth_dev
# Free public RPCs work but are rate-limited. For heavier use, make a free Alchemy key and use:
#   https://robinhood-mainnet.g.alchemy.com/v2/<KEY>  /  https://robinhood-testnet.g.alchemy.com/v2/<KEY>
RHC_MAINNET_RPC_URL=https://rpc.mainnet.chain.robinhood.com
RHC_TESTNET_RPC_URL=https://rpc.testnet.chain.robinhood.com
LOCAL_RPC_URL=http://127.0.0.1:8545
# debug | info | warn | error | silent
LOG_LEVEL=info

# ---------------------------------------------------------------- indexer (bin/indexer.ts)
# local | testnet | mainnet. The only process that polls the chain for logs.
INDEXER_CHAIN=local
INDEXER_PORT=8787
INDEXER_POLL_MS=2000
# Default 12 (0 on local).
INDEXER_CONFIRMATIONS=
# Default app/deployments.
INDEXER_DEPLOYMENTS_DIR=
INDEXER_FROM_BLOCK=
# Comma-separated linked spending wallets to index from the start.
INDEXER_WALLETS=
# Optional JSON file of extra streams.
INDEXER_STREAMS_FILE=

# ---------------------------------------------------------------- keeper (bin/keeper.ts)
KEEPER_CHAIN=local
KEEPER_PORT=8788
KEEPER_INTERVAL_MS=30000
KEEPER_DEPLOYMENTS_DIR=
# 32 bytes (0x-hex or base64) that seal the beacon secrets and Plaid tokens at rest: openssl rand -hex 32
KEEPER_SECRET_KEY=
# Signing key: KEEPER_PRIVATE_KEY, or a keystore file + a file holding its password.
KEEPER_PRIVATE_KEY=
KEEPER_KEYSTORE=
KEEPER_KEYSTORE_PASSWORD_FILE=
# Beacon windows committed ahead.
KEEPER_LOOKAHEAD=2
# Quiet delivery proofs are read this many blocks below the head (blank = 2 on testnet/mainnet, 0 on local).
KEEPER_CONFIRMATIONS=
# Comma-separated subset of refresh-mock-feeds,topups,roundups,spends,sweep,beacon,execute,deliver-quiet,deliver-hidden (blank = all).
KEEPER_JOBS=
# Statement / Plaid / on-chain accruals: keeper transactions per job per pass, and per user in any 7 days.
KEEPER_MAX_ACCRUALS_PER_PASS=
KEEPER_MAX_ACCRUALS_PER_USER_WEEK=
# Quiet delivery: parts per allocation (1-3), released across consecutive crowd executions.
SPLIT_PARTS=2
# Job refresh-mock-feeds, on testnet kit deployments only (mockFeeds: true in the deployment file): each mock feed
# older than this many seconds is re-posted from the real mainnet Chainlink feed (read over RHC_MAINNET_RPC_URL).
KEEPER_MOCK_FEED_INTERVAL_S=600
# 1 = when the real feed is stale (market closed), re-stamp its last answer anyway so testnet demos keep trading.
KEEPER_MOCK_FEED_KEEP_ALIVE=1
# A real feed whose last update is older than this (seconds) counts as stale (Chainlink heartbeat: 86400).
KEEPER_MOCK_FEED_REAL_STALE_S=86400
# After a refresh, swap the kit's v4 pool back to the new oracle price when it is further off than this (bps; 0 = never).
KEEPER_MOCK_FEED_ALIGN_BPS=50

# ---------------------------------------------------------------- relayer (bin/relayer.ts)
# Gasless Quiet claims and Hidden Vault withdraws. Its wallet pays gas.
RELAYER_CHAIN=local
RELAYER_PORT=8791
RELAYER_DEPLOYMENTS_DIR=
RELAYER_PRIVATE_KEY=
RELAYER_KEYSTORE=
RELAYER_KEYSTORE_PASSWORD_FILE=
# 1 = rate-limit by X-Forwarded-For (only behind your own reverse proxy).
RELAYER_TRUST_PROXY=0
RELAYER_IP_LIMIT=20
RELAYER_STEALTH_LIMIT=3
# Minimum withdraw fee per asset, "0xasset:raw,0xasset:raw" in raw token units; unlisted assets are free.
RELAYER_WITHDRAW_MIN_FEES=
RELAYER_CLAIM_MIN_RAW=

# ---------------------------------------------------------------- api (bin/api.ts)
# Read-only dashboard API; holds no keys (except the optional eligibility attester below).
API_CHAIN=local
API_PORT=8789
# 1 = take the client address from X-Forwarded-For (only behind your own reverse proxy, e.g. Caddy).
API_TRUST_PROXY=
API_DEPLOYMENTS_DIR=
# Comma-separated exact origins. Blank = the hosted frontend and http://localhost:5173.
CORS_ORIGINS=
# Round-up sources beyond on-chain spends (statement import, Plaid). 1 mounts /v1/roundups/*. Plaid also needs
# KEEPER_SECRET_KEY (tokens are stored sealed with it, so the API and the keeper must share it).
ROUNDUPS_ENABLED=0
# New statement rows one user may import in any 7 days (default 2000).
ROUNDUPS_MAX_ROWS_PER_WEEK=
# Statement imports per hour per client address (IPv6: per /64) and per wallet (defaults 30 and 10).
ROUNDUPS_IMPORT_IP_LIMIT=
ROUNDUPS_IMPORT_USER_LIMIT=
# sandbox (free) | production
PLAID_ENV=sandbox
PLAID_CLIENT_ID=
PLAID_SECRET=
# Countries offered in Plaid Link (comma-separated ISO codes).
PLAID_COUNTRY_CODES=US

# ---------------------------------------------------------------- eligibility (bin/eligibility.ts; also mounted by the API)
ELIGIBILITY_CHAIN=local
ELIGIBILITY_PORT=8790
# EligibilityRegistry address. Set = screening enabled (needs the attester key).
ELIGIBILITY_REGISTRY=
ELIGIBILITY_ATTESTER_KEY=
ELIGIBILITY_KEYSTORE=
ELIGIBILITY_KEYSTORE_PASSWORD_FILE=
# MMDB country database (`bun run download-ip-db`) and the cached OFAC address list.
ELIGIBILITY_IP_DB=data/dbip-country-lite.mmdb
ELIGIBILITY_SANCTIONS_CACHE=data/ofac-sdn-addresses.json
# Optional isSanctioned(address) oracle.
ELIGIBILITY_SANCTIONS_ORACLE=
# 1 = trust CF-IPCountry / CF-Connecting-IP / X-Forwarded-For (only behind Cloudflare or your own proxy).
ELIGIBILITY_TRUST_PROXY=0
# 1 = let IPs with no known country through (local development only).
ELIGIBILITY_ALLOW_UNKNOWN_IP=0
ELIGIBILITY_IP_LIMIT=10
ELIGIBILITY_ADDRESS_LIMIT=5

# ---------------------------------------------------------------- mcp (bin/mcp.ts; token issuance in the API)
MCP_PORT=8792
# HMAC key for per-treasury MCP tokens, >= 32 characters, the same for the API and the MCP server. Blank = off.
MCP_TOKEN_SECRET=
# The token a local agent uses with `bun run mcp --stdio`.
PLINTH_MCP_TOKEN=
# RPC for the MCP server (falls back to TREASURY_RPC_URL).
RPC_URL=
# Optional deployment JSON (default app/deployments/<chainid>.json + <chainid>-treasury.json).
DEPLOYMENT_JSON=

# ---------------------------------------------------------------- treasury (shared by the treasury services)
TREASURY_RPC_URL=
# Webhooks CLI only: skips reading the chain id from TREASURY_RPC_URL.
TREASURY_CHAIN_ID=
# Receipt polling for sent transactions (default 100 ms on anvil, 2000 ms elsewhere).
TREASURY_POLL_MS=
# The treasury the risk service watches.
TREASURY_ACCOUNT=
# Treasuries to mark / post receipts for: a comma-separated list and/or every treasury a factory created.
TREASURY_ACCOUNTS=
TREASURY_FACTORY=
# The policy controller (close, receipts, mirror snapshots): a key, or a keystore + password or password file.
TREASURY_CONTROLLER_KEY=
TREASURY_CONTROLLER_KEYSTORE=
TREASURY_CONTROLLER_KEYSTORE_PASSWORD=
TREASURY_CONTROLLER_KEYSTORE_PASSWORD_FILE=

# ---------------------------------------------------------------- treasury-desks (bin/treasury-desks.ts)
TREASURY_DESKS_PORT=8793
# Desk config JSON (contracts, policy template, desk settings).
TREASURY_CONFIG=
TREASURY_DESK_INTERVAL_S=300
TREASURY_CASH_DESK_KEY=
TREASURY_CASH_DESK_KEYSTORE=
TREASURY_CASH_DESK_KEYSTORE_PASSWORD=
TREASURY_CASH_DESK_KEYSTORE_PASSWORD_FILE=
TREASURY_EQUITY_DESK_KEY=
TREASURY_EQUITY_DESK_KEYSTORE=
TREASURY_EQUITY_DESK_KEYSTORE_PASSWORD=
TREASURY_EQUITY_DESK_KEYSTORE_PASSWORD_FILE=
# Exception jury: on | off. Model jurors run on a local Ollama when it answers; the rule juror always runs.
TREASURY_JURY=on
OLLAMA_HOST=
# Comma-separated Ollama models (blank = the built-in defaults).
TREASURY_JURY_MODELS=
TREASURY_JURY_TIMEOUT_MS=

# ---------------------------------------------------------------- treasury-close (bin/treasury-close.ts)
TREASURY_CLOSE_PORT=8794
# PeriodClose address.
TREASURY_PERIOD_CLOSE=
TREASURY_CLOSE_INTERVAL_S=600
# 1 = do not wait for the reconciler (a treasury with no perp venues).
TREASURY_CLOSE_SKIP_RECONCILE=0

# ---------------------------------------------------------------- treasury-risk (bin/treasury-risk.ts)
TREASURY_RISK_PORT=8795
# PositionMirror address (needed to push off-chain venue snapshots).
TREASURY_POSITION_MIRROR=
# Optional JSON file: [{ venue, positions: [{ underlying, tokens }], equityUsd, flowInSeen }]
RISK_STATIC_READERS=
# Comma-separated URLs for drawdown.state / risk.alert, signed with RISK_WEBHOOK_SECRET.
RISK_WEBHOOK_URLS=
RISK_WEBHOOK_SECRET=
RISK_INTERVAL_SEC=30
RISK_HYSTERESIS_BPS=50
# 1 = one tick, print the report, exit.
RISK_ONCE=0

# ---------------------------------------------------------------- treasury-receipts (bin/treasury-receipts.ts)
TREASURY_RECEIPTS_PORT=8796
# Receipts address.
TREASURY_RECEIPTS=
TREASURY_RECEIPTS_INTERVAL_S=300
# Seconds after an hour ends before it is closed.
TREASURY_RECEIPTS_GRACE_S=300

# ---------------------------------------------------------------- treasury-marks (bin/treasury-marks.ts)
TREASURY_MARKS_PORT=8797
TREASURY_MARK_INTERVAL_S=60

# ---------------------------------------------------------------- treasury-reconciler (bin/treasury-reconciler.ts)
TREASURY_RECONCILER_PORT=8798
# Reconciler config JSON (account, mirror, venues).
TREASURY_RECONCILE_CONFIG=
TREASURY_RECONCILE_INTERVAL_S=3600
# Trade-only venue API secret; never logged.
ORDERLY_SECRET=
# Comma-separated URLs for reconciliation breaks, signed with TREASURY_WEBHOOK_SECRET.
TREASURY_WEBHOOK_URLS=
TREASURY_WEBHOOK_SECRET=

# ---------------------------------------------------------------- treasury-webhooks (bin/treasury-webhooks.ts)
TREASURY_WEBHOOKS_PORT=8799
TREASURY_WEBHOOK_INTERVAL_S=15
