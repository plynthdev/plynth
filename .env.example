# Free public RPCs work but are rate-limited. For heavier use, make a free Alchemy key and use:
#   https://robinhood-mainnet.g.alchemy.com/v2/<KEY>  /  https://robinhood-testnet.g.alchemy.com/v2/<KEY>
RHC_MAINNET_RPC_URL=https://rpc.mainnet.chain.robinhood.com
RHC_TESTNET_RPC_URL=https://rpc.testnet.chain.robinhood.com

# Only needed when deploying to testnet. Use a brand-new wallet that never holds real funds.
# Better: `cast wallet import plynth-deployer --interactive` and leave this blank.
DEPLOYER_PRIVATE_KEY=

# Postgres (packages/db, apps/indexer). `bun run db:create && bun run db:migrate` sets it up.
DATABASE_URL=postgres://localhost:5432/plynth_dev
# Indexer: local | testnet | mainnet. Confirmations default 12 (0 on local). Wallets = comma-separated linked wallets.
INDEXER_CHAIN=local
LOCAL_RPC_URL=http://127.0.0.1:8545
INDEXER_WALLETS=

# Keeper (apps/keeper): local | testnet | mainnet. One pass every KEEPER_INTERVAL_MS, /health on KEEPER_PORT.
KEEPER_CHAIN=local
# 32 bytes (0x-hex or base64) that seal the beacon secrets at rest. Make one with: openssl rand -hex 32
KEEPER_SECRET_KEY=
# Signing key: leave KEEPER_PRIVATE_KEY blank and use a Foundry keystore instead
# (`cast wallet import plynth-keeper --interactive`, then point these at the file and a password file).
KEEPER_PRIVATE_KEY=
KEEPER_KEYSTORE=
KEEPER_KEYSTORE_PASSWORD_FILE=
KEEPER_PORT=8788
KEEPER_INTERVAL_MS=30000

# Dashboard API (apps/api): local | testnet | mainnet. Read-only; holds no keys.
API_CHAIN=local
API_PORT=8789
# Comma-separated exact origins. Blank = https://plynthlations.lovable.app and http://localhost:5173.
CORS_ORIGINS=
