# Free public RPCs work but are rate-limited. For heavier use, make a free Alchemy key and use:
#   https://robinhood-mainnet.g.alchemy.com/v2/<KEY>  /  https://robinhood-testnet.g.alchemy.com/v2/<KEY>
RHC_MAINNET_RPC_URL=https://rpc.mainnet.chain.robinhood.com
RHC_TESTNET_RPC_URL=https://rpc.testnet.chain.robinhood.com

# Only needed when deploying to testnet. Use a brand-new wallet that never holds real funds.
# Better: `cast wallet import plynth-deployer --interactive` and leave this blank.
DEPLOYER_PRIVATE_KEY=

# Postgres (packages/db, apps/indexer). `bun run db:create && bun run db:migrate` sets it up.
DATABASE_URL=postgres://localhost:5432/plynth_dev
# Indexer: local | testnet | mainnet. Confirmations default 12 (0 on local). Wallets = comma-separated linked wallets.
INDEXER_CHAIN=local
LOCAL_RPC_URL=http://127.0.0.1:8545
INDEXER_WALLETS=

# Keeper (apps/keeper): local | testnet | mainnet. One pass every KEEPER_INTERVAL_MS, /health on KEEPER_PORT.
KEEPER_CHAIN=local
# 32 bytes (0x-hex or base64) that seal the beacon secrets at rest. Make one with: openssl rand -hex 32
KEEPER_SECRET_KEY=
# Signing key: leave KEEPER_PRIVATE_KEY blank and use a Foundry keystore instead
# (`cast wallet import plynth-keeper --interactive`, then point these at the file and a password file).
KEEPER_PRIVATE_KEY=
KEEPER_KEYSTORE=
KEEPER_KEYSTORE_PASSWORD_FILE=
KEEPER_PORT=8788
KEEPER_INTERVAL_MS=30000
# Quiet delivery: parts per allocation (1-3), released across consecutive crowd executions.
SPLIT_PARTS=2

# Relayer (apps/relayer): gasless Quiet claims. Its wallet pays gas (no fee in v1); prefer a keystore.
RELAYER_CHAIN=local
RELAYER_PRIVATE_KEY=
RELAYER_KEYSTORE=
RELAYER_KEYSTORE_PASSWORD_FILE=
# Default 8789 is the same as API_PORT's default: set one of them when running both on one host.
RELAYER_PORT=8789
# 1 = rate-limit by X-Forwarded-For (only behind your own reverse proxy).
RELAYER_TRUST_PROXY=0
RELAYER_IP_LIMIT=20
RELAYER_STEALTH_LIMIT=3

# Dashboard API (apps/api): local | testnet | mainnet. Read-only; holds no keys.
API_CHAIN=local
API_PORT=8789
# Comma-separated exact origins. Blank = https://plynthlations.lovable.app and http://localhost:5173.
CORS_ORIGINS=

# Eligibility screen (apps/eligibility; also mounted by the API when ELIGIBILITY_REGISTRY is set).
ELIGIBILITY_CHAIN=local
ELIGIBILITY_PORT=8790
ELIGIBILITY_REGISTRY=
# Attester signing key: prefer a Foundry keystore (ELIGIBILITY_KEYSTORE + ELIGIBILITY_KEYSTORE_PASSWORD_FILE).
ELIGIBILITY_ATTESTER_KEY=
ELIGIBILITY_KEYSTORE=
ELIGIBILITY_KEYSTORE_PASSWORD_FILE=
# MMDB country database (bun apps/eligibility/scripts/download-dbip.ts) and the cached OFAC address list.
ELIGIBILITY_IP_DB=data/dbip-country-lite.mmdb
ELIGIBILITY_SANCTIONS_CACHE=data/ofac-sdn-addresses.json
# Optional isSanctioned(address) oracle. None is deployed on Robinhood Chain (checked 2026-10-04).
ELIGIBILITY_SANCTIONS_ORACLE=
# 1 = trust CF-IPCountry / CF-Connecting-IP / X-Forwarded-For (only behind Cloudflare or your own proxy).
ELIGIBILITY_TRUST_PROXY=0
# 1 = let IPs with no known country through (local development only).
ELIGIBILITY_ALLOW_UNKNOWN_IP=0
ELIGIBILITY_IP_LIMIT=10
ELIGIBILITY_ADDRESS_LIMIT=5

# Round-up sources beyond on-chain (statement import + Plaid). The API mounts /v1/roundups/* when
# ROUNDUPS_ENABLED=1; Plaid routes and the keeper's Plaid sync also need PLAID_CLIENT_ID + PLAID_SECRET and
# KEEPER_SECRET_KEY (access tokens are stored sealed with it, so the API and keeper must share it).
ROUNDUPS_ENABLED=0
# sandbox (free) | production. Same code for both; production keys are an operator decision.
PLAID_ENV=sandbox
PLAID_CLIENT_ID=
PLAID_SECRET=
# Countries offered in Plaid Link (comma-separated ISO codes).
PLAID_COUNTRY_CODES=US
