{
  // Inside this workspace, @plynth/sdk resolves to its TypeScript sources (Bun honours these paths), so apps and
  // tests never need a build. The published package (packages/sdk/dist) is what package.json "exports" names.
  "compilerOptions": {
    "paths": {
      "@plynth/sdk": ["./packages/sdk/src/index.ts"],
      "@plynth/sdk/*": ["./packages/sdk/src/*/index.ts"]
    }
  }
}
