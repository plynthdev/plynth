# Frontend settings (Vite exposes VITE_* to the browser: never put a secret here).
# Copy to .env.local (fork), .env.testnet.local (`bun run dev:testnet`) or .env.mainnet.local (`bun run dev:mainnet`).
# On Vercel set the same names in Project Settings -> Environment Variables.

# 31337 local fork (default) | 46630 Robinhood Chain testnet | 4663 Robinhood Chain mainnet (closed beta).
# A production build without VITE_CHAIN_ID shows the preview dashboard.
VITE_CHAIN_ID=4663
# Defaults per chain: mainnet https://rpc.mainnet.chain.robinhood.com, testnet https://rpc.testnet.chain.robinhood.com,
# fork http://127.0.0.1:8545.
VITE_RPC_URL=https://rpc.mainnet.chain.robinhood.com
# Dashboard API and relayer. `vite dev` proxies them (no CORS); a build calls them directly, so the API's
# CORS_ORIGINS must list the site's origin.
VITE_API_URL=
VITE_RELAYER_URL=
# 1 offers the anvil dev-key wallet, and only on localhost with chain 31337. Always 0 in production.
VITE_DEV_WALLET=0
# Optional: explorer base URL (defaults: https://robinhoodchain.blockscout.com, the testnet Blockscout, none on the fork).
VITE_EXPLORER_URL=
# Optional: wallet network name (defaults per chain).
VITE_CHAIN_NAME=
# 0 shows the preview dashboard instead of the live one.
VITE_FORK=

# Build-time only (not sent to the browser): the deployment file to inline. Default per chain, first that exists:
# ../app/deployments/fork.json | 46630.json | 4663.json, then 4663-beta.json. None -> "not deployed yet".
FORK_DEPLOYMENT_JSON=
